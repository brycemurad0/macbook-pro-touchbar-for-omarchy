[Unit]
Description=Omarchy voice agent (Pipecat: Silero VAD, Moonshine STT, Gemini brain, ElevenLabs voice, local tools)
After=graphical-session.target

[Service]
# Pipecat needs the project venv:
#   python3 -m venv .venv && .venv/bin/pip install 'pipecat-ai[silero,moonshine,elevenlabs,google]'
ExecStart=/home/USER/.config/omarchy/touchbar/.venv/bin/python /home/USER/.config/omarchy/touchbar/pipecat_voice.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
